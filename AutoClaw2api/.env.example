# -*- coding: utf-8 -*-
"""AutoClaw2api 环境变量样例。复制为 .env 后按需修改。

.env 由 load_dotenv() 读取；未列出的变量用 server.py 里的默认值。
**不要把 accessToken 写进这里** —— 凭据一律从桌面端的 v10 密文现场解密，
桌面端刷新登录态后本服务按 mtime 自动跟随。
"""
# 监听地址。默认仅回环：AutoClaw 凭据绑死本机 DPAPI，监听 0.0.0.0 等于
# 把「同网段任何人都能调你的 AutoClaw 账号」敞开，除非你明确知道在做什么。
HOST=127.0.0.1
PORT=8378

# 本地 API Key。留空 = 不校验（配合上面的回环监听就是「本机随便调」）。
# 客户端在 Authorization: Bearer <API_KEY> 里带。
API_KEY=

# AutoClaw 用户数据根（Chromium profile）。默认 %APPDATA%/AutoClaw-official。
# AUTOCLAW_BASE=
# 多账号登录时指定账号目录名（sha256(accountId)），默认取 mtime 最新的。
# AUTOCLAW_ACCOUNT=

# 客户端身份。改版本号可与桌面端错开，但别改成不存在的版本——上游虽不校验，
# 出问题时按版本回溯会干扰判断。
AUTOCLAW_APP_VERSION=2.1.0
# managedPlatform()：win32->win, darwin->mac
AUTOCLAW_PLATFORM=win

# appKey：main.cjs 里明文硬编码的 32 位十六进制客户端标识，用于算
# X-Auth-Sign = md5(appId & timestamp & appKey)。
# 源码里有默认值（本机 2.1.0 main.cjs:466500 实证），此项留空即可正常工作；
# 仅当上游轮换 appKey 时才需要覆盖。实测（probe7 F）证明 X-Auth-Sign 族不是
# 门禁，三个头全删仍 200——所以它错了也不影响可用性，但排障时会是干扰项。
# AUTOCLAW_APP_KEY=

# 上游与默认模型
AUTOCLAW_UPSTREAM_BASE=https://autoglm-acceleration-api.zhipuai.cn/autoclaw-proxy/proxy/autoclaw
# 客户端没填 model 时用这个。填了就以客户端的为准（原样透传，不映射）。
AUTOCLAW_DEFAULT_MODEL=zai_auto

# 凭据来源。desktop = 解密桌面端 DPAPI 密文（要同机同用户、装着桌面端，
# 桌面端退出登录就断）；oauth = 自己走账号面 OAuth 换 token，DPAPI 加密后存
# .cred/，不依赖桌面端。选 oauth 时 desktop 那份仍然只读、不碰，两者可并存，
# 想切回去改这个变量即可。默认 desktop。
# **注意：oauth 模式当前未打通**——账号面的 oauth-url 端点返回业务码 631000
# （「抱歉, 登录失败,请重新尝试」），拿不到授权链接。请求形状已与桌面端
# 2.1.0 main.cjs 逐字段对齐、TLS 指纹也已排除（Node 同栈 fetch 同样失败），
# 同一套签名头的 captcha-config 返回 code:0，所以不是请求写错了，而是服务端
# 在账号/环境层拒绝（captcha-config 报 region:"ga" 提示出口 IP 可能被识别成
# 非国内区域）。桌面端凭据解密（desktop）是当前可用的来源。
# AUTOCLAW_CRED_SOURCE=desktop
# OAuth 模式下凭据的存放目录（默认 <本文件所在目录>/.cred）。
# AUTOCLAW_OAUTH_DIR=

# 账号面（积分/任务/流水）的 base。**裸域名，不带路径**——注意它和上面的
# AUTOCLAW_UPSTREAM_BASE 不是一回事：账号面的任务端点是
# /autoclaw-proxy/proxy/autoclaw-task-list，与 UPSTREAM_BASE 的
# /autoclaw-proxy/proxy/autoclaw 是**兄弟**路径，中间没有 autoclaw 这一段。
# 把 UPSTREAM_BASE 当 base 传进去会 404（实测）。默认值即下列值，留空即可。
# AUTOCLAW_ACCOUNT_BASE=https://autoglm-acceleration-api.zhipuai.cn

# 落盘请求/响应原文到 dumps/，排障时很有用。**绝不落 header**，明文 JWT 不外泄。
DUMP=1
DUMP_MAX_FILES=200
